# Copy this file to .env for local development (Railway: set these in the dashboard instead)

PORT=3000

# Twilio (from console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# The public URL Twilio will hit for inbound SMS webhooks, e.g. your Railway
# domain. Used to validate the Twilio request signature.
PUBLIC_BASE_URL=https://your-app.up.railway.app

# Optional: path to the SQLite file. Point this at a mounted Railway volume
# (e.g. /data/toerilla.db) so data survives redeploys.
DB_PATH=
