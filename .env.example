# Copy this file to .env for local development.
# On Railway/Render/Fly, set these as real environment variables in their dashboard instead.

# --- Database (required) ---
# Railway/Render Postgres add-ons provide this automatically as DATABASE_URL.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/toerilla
# Set to "disable" for local Postgres without SSL. Leave unset in production.
PGSSLMODE=disable

# --- App ---
PORT=3000
# Public base URL this server is reachable at (used to build Stripe redirect URLs).
APP_BASE_URL=http://localhost:3000
# Origin allowed to call this API from the browser (your landing page's domain).
# Use * while testing, lock it down to https://toerillagignetwork.com before launch.
ALLOWED_ORIGIN=*
# Shared secret for the admin dashboard (pick any long random string).
ADMIN_TOKEN=change-me-to-a-long-random-string

# --- Twilio (optional — omit to run in log-only fallback mode) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Stripe (optional — omit to run with fake placeholder checkout links) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Create these as recurring Prices in the Stripe Dashboard, then paste their IDs here.
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_AUTO_BOOK_PREMIUM=
